# Supabase Configuration (required in production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Public application URL (required for production auth callbacks)
NEXT_PUBLIC_APP_URL=https://your-production-domain.example

# Email Service (optional; required when sending transactional email)
RESEND_API_KEY=your_resend_api_key_here
# Remitente de los correos. Al verificar el dominio en Resend: BuscoMiMascota <notificaciones@tudominio.com>
EMAIL_FROM=
EMAIL_TEST_TOKEN=replace-me-local-test-token

# AI chatbot service (optional; required when enabling the chatbot)
GROQ_API_KEY=your_groq_api_key_here


# Supabase Edge Function CORS allow-list
ALLOWED_ORIGIN=https://your-production-domain.example

# Import scripts only; never expose this key to the browser
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:contacto@your-production-domain.example

# Error monitoring (optional; create a Sentry project and paste its DSN)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Tarea diaria "¿ya apareció?" (GET /api/cron/remind-owners con Authorization: Bearer <valor>)
CRON_SECRET=

# Contacto y apoyo (opcionales: lo que no se defina no se muestra en /contacto)
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_COLLAB_GROUP_URL=
NEXT_PUBLIC_YAPE_NUMBER=
NEXT_PUBLIC_PLIN_NUMBER=
NEXT_PUBLIC_SUPPORT_HOLDER=

# Google Search Console: codigo de verificacion (meta tag)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
